# Copy to .env (same folder) and fill in. Read by server/ and agent/ via `npm start` / `npm run dev`.

# Claude: AI shift interview (server) and the live voice agent's brain (agent)
ANTHROPIC_API_KEY=

# LiveKit Cloud project (https://cloud.livekit.io → Settings → API keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional overrides for the voice agent
# BIJAK_VOICE_MODEL=claude-opus-4-8
# BIJAK_TTS_VOICE=a167e0f3-df7e-4d52-a9c3-f949145efdab
