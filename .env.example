# Copy this file to .env (local) or add these to Replit Secrets.
# Never commit your real .env file.
PROJECT_NAME="BijakMatch (ReRole Green)"

# Claude: AI shift interview, market analysis (src/server) and the live voice agent's brain (src/agent)
ANTHROPIC_API_KEY=

# LiveKit Cloud project (https://cloud.livekit.io -> Settings -> API keys): live voice skill check
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional overrides for the voice agent
# BIJAK_VOICE_MODEL=claude-opus-4-8
# BIJAK_TTS_VOICE=a167e0f3-df7e-4d52-a9c3-f949145efdab

# RunPod (see README "How We Use RunPod"). One API key covers all three uses:
RUNPOD_API_KEY=your-runpod-api-key
# 1) Your own Serverless endpoint for GPU speech-to-text (runpod/handler.py)
RUNPOD_ENDPOINT_ID=your-endpoint-id
# 2) GLM-5.3 on RunPod's public endpoint runs the interview when no Anthropic key is set (text only).
#    Uses the same RUNPOD_API_KEY. Set RUNPOD_LLM=off to switch it off.
# RUNPOD_LLM_BASE_URL=https://api.runpod.ai/v2/b1dd8hy2hqo1nb/openai/v1
# RUNPOD_LLM=off
# 3) Model training runs on a RunPod Pod (runpod/train/); the Pod needs no key.
