# Copy this file to .env (local) or add these to Replit Secrets.
# Never commit your real .env file.
PROJECT_NAME="BijakMatch (ReRole Green)"

# Claude: AI shift interview, market analysis (src/server) and the live voice agent's brain (src/agent)
ANTHROPIC_API_KEY=

# LiveKit Cloud project (https://cloud.livekit.io -> Settings -> API keys): live voice skill check
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional overrides for the voice agent
# BIJAK_VOICE_MODEL=claude-opus-4-8
# BIJAK_TTS_VOICE=a167e0f3-df7e-4d52-a9c3-f949145efdab

# RunPod (organiser template). Not used by the app yet; see README "How We Use RunPod".
RUNPOD_API_KEY=your-runpod-api-key
RUNPOD_ENDPOINT_ID=your-endpoint-id
